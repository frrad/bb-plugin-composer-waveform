{
  "name": "bb-plugin-composer-waveform",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "bb's composer with a rebindable voice-input shortcut: Mod+D toggles recording, Enter while recording transcribes and sends.",
  "engines": {
    "bb": ">=0.48.0 <0.49.0",
    "bbPluginSdk": ">=0.6.77"
  },
  "bb": {
    "name": "Composer (voice shortcut)",
    "description": "bb's composer with a rebindable voice-input shortcut: Mod+D toggles recording, Enter while recording transcribes and sends.",
    "branding": {
      "icon": "MessageSquare"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "bench": "cross-env PROMPTBOX_PERF=1 vitest run --config vitest.config.ts src/editor/prompt-paste-performance.test.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-document": "3.26.0",
    "@tiptap/extension-hard-break": "3.26.0",
    "@tiptap/extension-mention": "3.26.0",
    "@tiptap/extension-paragraph": "3.26.0",
    "@tiptap/extension-text": "3.26.0",
    "@tiptap/extensions": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/suggestion": "3.26.0",
    "nanoid": "^5.1.6",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
